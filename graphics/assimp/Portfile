PortGroup           cmake 1.1
PortGroup           github 1.0
PortGroup           legacysupport 1.1

# strnlen
legacysupport.newest_darwin_requires_legacy 10

github.setup        assimp assimp 6.0.5 v
github.tarball_from archive
revision            0
checksums           rmd160  0bc3b71907ee203e0fa56355e6113ee79022355e \
                    sha256  edf3749559c2b7d1f758ffb66fc5bec62186221e623b7f2e8969f17ee46ecb6f \
                    size    152371278

conflicts           assimp2 assimp5
categories          graphics
maintainers         {reneeotten @reneeotten} openmaintainer
license             BSD

description         library to import/export 3-D model formats
long_description    Open Asset Import Library (short name: Assimp) is a \
                    portable Open Source library to import various well-known \
                    3-D model formats in a uniform manner. The most recent \
                    version also knows how to export 3-D files and is therefore \
                    suitable as a general-purpose 3-D model converter.

homepage            https://www.assimp.org

depends_build-append \
                    path:bin/pkg-config:pkgconfig \
                    path:lib/pkgconfig/RapidJSON.pc:rapidjson

depends_lib         port:minizip \
                    port:pugixml \
                    port:zlib

patch.pre_args-replace  -p0 -p1
# patches from Debian: https://sources.debian.org/patches/assimp/6.0.5+ds-1/
patchfiles          use-system-rapidjson.patch \
                    use-system-pugixml.patch \
                    private-libraries.patch \
                    minizip-1.3.1.2.patch \
                    pyassimp_faces.patch

compiler.c_standard 1999
compiler.cxx_standard 2017
compiler.thread_local_storage yes

configure.args-append -DASSIMP_BUILD_ASSIMP_TOOLS=ON \
                      -DASSIMP_BUILD_TESTS=OFF \
                      -DASSIMP_WARNINGS_AS_ERRORS=OFF \
                      -DASSIMP_BUILD_ZLIB=OFF \
                      -DASSIMP_BUILD_USE_CCACHE=OFF

github.livecheck.regex {(\d+(\.\d+)+)}
